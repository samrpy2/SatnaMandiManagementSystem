@model UserLogin.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "सुरक्षित पासवर्ड बदलें";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 card p-4 shadow-sm border-primary">
        <h3 class="text-center text-primary mb-4">🔐 सुरक्षित पासवर्ड बदलें</h3>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- 1. पुराना पासवर्ड -->
            <div class="mb-3">
                <label class="form-label fw-bold">पुराना पासवर्ड (Current Password)</label>
                <input asp-for="OldPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>

            <!-- 2. नया पासवर्ड -->
            <div class="mb-3">
                <label class="form-label fw-bold">नया पासवर्ड (New Password)</label>
                <input asp-for="NewPassword" class="form-control" placeholder="कम से कम 6 अक्षर" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- 3. कन्फर्म पासवर्ड -->
            <div class="mb-3">
                <label class="form-label fw-bold">नया पासवर्ड दोबारा डालें (Confirm)</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- एक्शन्स बटन्स -->
            <div class="d-flex justify-content-between mt-4">
                <a href="/Home/Index" class="btn btn-secondary w-45">वापस जाएँ</a>
                <button type="submit" class="btn btn-primary w-45 fw-bold">💾 सेव करें</button>
            </div>
        </form>
    </div>
</div>
